# Copy values into your shell/hosting environment; never put real credentials here.
# PGHOST should be the Neon pooled hostname when using pooled connections.
PGHOST=your-neon-pooled-hostname
PGDATABASE=your_database
PGUSER=your_username
PGPASSWORD=replace_with_secret
PGSSLMODE=require
PGCHANNELBINDING=require
NEON_POOL_SIZE=5
NEON_MIN_IDLE=0

# Cloudinary settings are Flutter build-time values, not backend secrets.
# Set CLOUDINARY_CLOUD_NAME and CLOUDINARY_UPLOAD_PRESET with --dart-define.
# Never put CLOUDINARY_API_SECRET in the Flutter app.
