# Copy this file to backend/.env and supply values from your secret manager.
# Set DATABASE_URL (or NEON_DATABASE_URL), or use the individual PG* settings.
DATABASE_URL=
# NEON_DATABASE_URL=

# Individual PostgreSQL settings (used when neither URL is set).
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require
NEON_POOL_SIZE=5
NEON_MIN_IDLE=0

# Optional backend-only credentials for signed product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
