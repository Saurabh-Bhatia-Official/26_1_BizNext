# Copy values into your shell/hosting environment; never put real credentials here.
# DATABASE_URL accepts the Neon postgresql:// URL or a jdbc:postgresql:// URL.
DATABASE_URL=postgresql://user:password@your-neon-hostname/your_database?sslmode=require

# Alternatively use the individual Neon variables below.
# PGHOST should be the Neon pooled hostname when using pooled connections.
PGHOST=your-neon-pooled-hostname
PGDATABASE=your_database
PGUSER=your_username
PGPASSWORD=replace_with_secret
PGSSLMODE=require
PGCHANNELBINDING=require
NEON_POOL_SIZE=5
NEON_MIN_IDLE=0

# Product images are uploaded by the backend with signed Cloudinary requests.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
